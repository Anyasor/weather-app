<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { pageTitle }) %>
</head>
<body>

    <div class="bg-orb orb-1"></div>
    <div class="bg-orb orb-2"></div>
    <div class="bg-orb orb-3"></div>

    <nav class="navbar navbar-dark glass-nav sticky-top">
        <div class="container py-2">
            <span class="navbar-brand d-flex align-items-center gap-2 fw-bold fs-5">
                <span class="brand-mark rounded-3 d-grid place-items-center"><i class="bi bi-cloud-sun-fill"></i></span>
                Skyline <span class="text-muted-soft fw-normal">Forecast</span>
            </span>
            <div class="d-none d-sm-flex align-items-center gap-2 text-white-50 small">
                <i class="bi bi-dot text-accent"></i> Live · Powered by OpenWeatherMap
            </div>
        </div>
    </nav>

    <main class="container my-4 my-md-5 pb-5">
        <header class="text-center mb-4 mb-md-5">
            <h1 class="display-6 fw-bold mb-2">Weather, refined.</h1>
            <p class="text-white-50 col-md-7 mx-auto mb-0">
                Search any city or use your location for an instant, detailed 5-day outlook.
            </p>
        </header>

        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                <form id="searchForm" class="search-wrap rounded-4 p-2 d-flex align-items-center gap-2" role="search" action="/" method="get">
                    <i class="bi bi-search text-white-50 ps-2 fs-5"></i>
                    <input type="text" id="cityInput" name="city" class="search-input flex-grow-1" placeholder="Enter a city, e.g. Tokyo" autocomplete="off">
                    <button id="searchBtn" class="btn btn-accent px-4 py-2" type="submit">
                        <i class="bi bi-search d-sm-none"></i>
                        <span class="d-none d-sm-inline">Search</span>
                    </button>
                    <button id="geoBtn" class="btn btn-geo px-3 py-2" type="button" title="Use my location">
                        <i class="bi bi-crosshair"></i>
                    </button>
                </form>
                <p class="text-center text-white-50 small mt-3 mb-0">
                    <i class="bi bi-lightning-charge-fill text-accent"></i> Try: Tokyo, London, New York
                </p>
            </div>
        </div>

        <div id="alert" class="alert alert-glass fade <%= error ? 'show' : 'd-none' %> text-center col-lg-6 mx-auto mt-4 mb-0" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><span id="alertMsg"><%= error || '' %></span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>

        <div id="loading" class="text-center text-white-50 d-none py-5">
            <div class="spinner">
                <i class="bi bi-cloud-sun-fill"></i>
            </div>
            <p class="mt-3 mb-0 fw-semibold">Fetching the forecast…</p>
        </div>

        <section id="weatherResult" class="<%= view ? '' : 'd-none' %>">
            <% if (view) { %>

            <div class="row justify-content-center mb-4">
                <div class="col-lg-10">
                    <article class="glass-card current-card rounded-4 overflow-hidden">
                        <div class="row g-0 p-4 p-md-5">
                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-2 mb-1 text-accent small fw-semibold">
                                    <i class="bi bi-geo-alt-fill"></i><span id="cityName"><%= view.cityName %></span>
                                </div>
                                <p class="text-white-50 small mb-3" id="currentDate"><%= view.currentDate %></p>
                                <div class="d-flex align-items-end gap-3">
                                    <span class="display-3 fw-extrabold lh-1" id="currentTemp"><%= view.temp %>°</span>
                                    <div>
                                        <div class="fs-3" id="currentIcon"><i class="bi <%= view.icon %>"></i></div>
                                        <p class="mb-0 text-white-50" id="currentDesc"><%= view.desc %> · Feels like <%= view.feelsLike %>°</p>
                                    </div>
                                </div>
                                <p class="mb-0 mt-3 text-white-75 small" id="currentHighLow">H <%= view.high %>° · L <%= view.low %>°</p>
                            </div>
                            <div class="col-md-6">
                                <h2 class="text-uppercase small text-white-50 mb-3 mt-4 mt-md-0">
                                    <i class="bi bi-grid-1x2 me-1"></i> Conditions
                                </h2>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <div class="stat-tile"><i class="bi bi-thermometer-half"></i><span class="stat-value" id="statFeelsLike"><%= view.feelsLike %>°C</span><span class="stat-label">Feels like</span></div>
                                    </div>
                                    <div class="col-6">
                                        <div class="stat-tile"><i class="bi bi-droplet-half"></i><span class="stat-value" id="statHumidity"><%= view.humidity %></span><span class="stat-label">Humidity</span></div>
                                    </div>
                                    <div class="col-6">
                                        <div class="stat-tile"><i class="bi bi-wind"></i><span class="stat-value" id="statWind"><%= view.wind %></span><span class="stat-label">Wind</span></div>
                                    </div>
                                    <div class="col-6">
                                        <div class="stat-tile"><i class="bi bi-sun"></i><span class="stat-value" id="statUV"><%= view.uv %></span><span class="stat-label">UV index</span></div>
                                    </div>
                                    <div class="col-6">
                                        <div class="stat-tile"><i class="bi bi-sunrise"></i><span class="stat-value" id="statSunrise"><%= view.sunrise %></span><span class="stat-label">Sunrise</span></div>
                                    </div>
                                    <div class="col-6">
                                        <div class="stat-tile"><i class="bi bi-sunset"></i><span class="stat-value" id="statSunset"><%= view.sunset %></span><span class="stat-label">Sunset</span></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </article>
                </div>
            </div>

            <div class="col-lg-10 mx-auto mb-4">
                <h2 class="section-title"><i class="bi bi-clock-history"></i> Next 12 Hours</h2>
                <div id="hourlyRow" class="hourly-scroll d-flex gap-2 py-2">
                    <% view.hourly.forEach((h) => { %>
                    <div class="hour-card">
                        <div class="hour-time"><%= h.time %></div>
                        <div class="hour-icon my-2"><i class="bi <%= h.icon %>"></i></div>
                        <div class="hour-temp"><%= h.temp %>°</div>
                        <div class="hour-precip">💧 <%= h.precip %>%</div>
                    </div>
                    <% }) %>
                </div>
            </div>

            <div class="col-lg-10 mx-auto">
                <h2 class="section-title"><i class="bi bi-calendar-week"></i> 5-Day Outlook</h2>
                <div class="glass-card rounded-4 p-3 p-md-4">
                    <div id="weeklyRow" class="d-flex flex-column">
                        <% view.weekly.forEach((d) => { %>
                        <div class="day-row">
                            <div class="day-name"><%= d.day %></div>
                            <div class="day-icon"><i class="bi <%= d.icon %>"></i></div>
                            <div class="temp-bar">
                                <div class="temp-bar-fill" style="left: <%= d.barLeft %>% ;width: <%= d.barWidth %>%"></div>

                            </div>
                            <div class="day-temps">
                                <span class="hi"><%= d.high %>°</span> <span class="lo"><%= d.low %>°</span>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                </div>
            </div>

            <% } %>
        </section>
    </main>

    <%- include('partials/footer', { year }) %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios@1.7.9/dist/axios.min.js"></script>
    <script src="/script.js"></script>
</body>
</html>
